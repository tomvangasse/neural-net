# Virtual environment — 159 MB of installed packages. Never commit this;
# it's rebuildable from a requirements file and is machine-specific.
.venv/

# Python bytecode caches
__pycache__/
*.py[cod]

# macOS Finder metadata
.DS_Store

# Downloaded datasets / model weights
data/
*.npz
*.pt
*.pth

# Generated from mnist_model.npz by export_weights.py (deploy.sh re-runs it)
web/weights.json

# pytest's cache of last-failed tests etc.
.pytest_cache/

# Claude Code local config (editor-specific, not part of the project)
.claude/
